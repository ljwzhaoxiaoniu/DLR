  "sql": "SELECT s.School, s.Street, s.City, s.State, s.Zip, ABS(f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)`) AS diff\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nWHERE ABS(f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)`) > 30\nORDER BY diff DESC\nLIMIT 200",
