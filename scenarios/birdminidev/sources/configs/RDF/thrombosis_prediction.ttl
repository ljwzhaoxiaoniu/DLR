        rdfs:comment "pattern observed in the sheet of ANA examination"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/aCL_IgA> ; rr:objectMap [ rr:column "aCL IgA" ; rr:datatype xsd:string ] ;
        rdfs:label "anti-Cardiolipin antibody (IgA) concentration"@en ;
        rdfs:comment "anti-Cardiolipin antibody (IgA) concentration"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/Diagnosis> ; rr:objectMap [ rr:column "Diagnosis" ; rr:datatype xsd:string ] ;
        rdfs:label "Diagnosis"@en ;
        rdfs:comment "disease names"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/KCT> ; rr:objectMap [ rr:column "KCT" ; rr:datatype xsd:string ] ;
        rdfs:label "measure of degree of coagulation"@en ;
        rdfs:comment "measure of degree of coagulation. +: positive -: negative"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/RVVT> ; rr:objectMap [ rr:column "RVVT" ; rr:datatype xsd:string ] ;
        rdfs:label "measure of degree of coagulation"@en ;
        rdfs:comment "measure of degree of coagulation. +: positive -: negative"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/LAC> ; rr:objectMap [ rr:column "LAC" ; rr:datatype xsd:string ] ;
        rdfs:label "measure of degree of coagulation"@en ;
        rdfs:comment "measure of degree of coagulation. +: positive -: negative"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/Symptoms> ; rr:objectMap [ rr:column "Symptoms" ; rr:datatype xsd:string ] ;
        rdfs:label "Symptoms"@en ;
        rdfs:comment "other symptoms observed"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/Thrombosis> ; rr:objectMap [ rr:column "Thrombosis" ; rr:datatype xsd:string ] ;
        rdfs:label "Thrombosis"@en ;
        rdfs:comment "degree of thrombosis. 0: negative (no thrombosis) 1: positive (the most severe one) 2: positive (severe)3: positive (mild)"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/refers_to_Patient> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/thrombosis_prediction/Patient> ; rr:joinCondition [ rr:child "ID" ; rr:parent "ID" ] ] ] .

