# === Table: thrombosis_prediction.Examination (no physical pk) ===
<http://example.org/tm/thrombosis_prediction/Examination> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Examination" ] ;
    rr:subjectMap [ rr:template "http://example.org/thrombosis_prediction/{ID}" ; rr:class ex:Examination ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/Examination/ID> ; rr:objectMap [ rr:column "ID" ; rr:datatype xsd:string ] ;
        rdfs:label "ID"@en ;
        rdfs:comment "identification of the patient"@en ] ;
