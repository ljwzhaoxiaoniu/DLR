# === Table: student_club.attendance (pk=link_to_event+link_to_member) ===
<http://example.org/tm/student_club/attendance> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "attendance" ] ;
    rr:subjectMap [ rr:template "http://example.org/student_club/{link_to_member}" ; rr:class ex:attendance ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/attendance/link_to_event> ; rr:objectMap [ rr:column "link_to_event" ; rr:datatype xsd:string ] ;
        rdfs:label "link to event"@en ;
        rdfs:comment "The unique identifier of the event which was attended. References the Event table"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/attendance/link_to_member> ; rr:objectMap [ rr:column "link_to_member" ; rr:datatype xsd:string ] ;
        rdfs:label "link to member"@en ;
        rdfs:comment "The unique identifier of the member who attended the event. References the Member table"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/attendance/refers_to_member> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/student_club/member> ; rr:joinCondition [ rr:child "link_to_member" ; rr:parent "member_id" ] ;
        rdfs:label "参与成员"@zh ;
        rdfs:comment "FK：attendance.link_to_member → member.member_id"@zh ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/attendance/refers_to_event> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/student_club/event> ; rr:joinCondition [ rr:child "link_to_event" ; rr:parent "event_id" ] ;
        rdfs:label "所属活动"@zh ;
        rdfs:comment "FK：attendance.link_to_event → event.event_id"@zh ] ] .

# === Table: student_club.budget (pk=budget_id) ===
<http://example.org/tm/student_club/budget> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "budget" ] ;
    rr:subjectMap [ rr:template "http://example.org/student_club/{budget_id}" ; rr:class ex:budget ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/budget_id> ; rr:objectMap [ rr:column "budget_id" ; rr:datatype xsd:string ] ;
        rdfs:label "budget id"@en ;
        rdfs:comment "A unique identifier for the budget entry"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/category> ; rr:objectMap [ rr:column "category" ; rr:datatype xsd:string ] ;
        rdfs:label "category"@en ;
        rdfs:comment "The area for which the amount is budgeted, such as, advertisement, food, parking"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/spent> ; rr:objectMap [ rr:column "spent" ; rr:datatype xsd:string ] ;
        rdfs:label "spent"@en ;
        rdfs:comment "The total amount spent in the budgeted category for an event.. the unit is dollar. This is summarized from the Expense table"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/remaining> ; rr:objectMap [ rr:column "remaining" ; rr:datatype xsd:string ] ;
        rdfs:label "remaining"@en ;
        rdfs:comment "A value calculated as the amount budgeted minus the amount spent. the unit is dollar commonsense evidence: If the remaining < 0, it means that the cost has exceeded the budget."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/amount> ; rr:objectMap [ rr:column "amount" ; rr:datatype xsd:string ] ;
        rdfs:label "amount"@en ;
        rdfs:comment "The amount budgeted for the specified category and event. the unit is dollar commonsense evidence: some computation like: amount = spent + remaining"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/event_status> ; rr:objectMap [ rr:column "event_status" ; rr:datatype xsd:string ] ;
        rdfs:label "event status"@en ;
        rdfs:comment "the status of the event. Closed / Open/ Planning commonsense evidence:  Closed: It means that the event is closed. The spent and the remaining won't change anymore.  Open: It means that the event is already opened. The spent and the remaining will change with new expenses.  Planning: The event is not started yet but is planning. The spent and the remaining won't change at this stage."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/link_to_event> ; rr:objectMap [ rr:column "link_to_event" ; rr:datatype xsd:string ] ;
        rdfs:label "link to event"@en ;
        rdfs:comment "The unique identifier of the event to which the budget line applies.. References the Event table"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/budget/refers_to_event> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/student_club/event> ; rr:joinCondition [ rr:child "link_to_event" ; rr:parent "event_id" ] ] ] .

