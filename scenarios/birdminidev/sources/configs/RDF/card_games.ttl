# === Table: card_games.sets (pk=id) ===
<http://example.org/tm/card_games/sets> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "sets" ] ;
    rr:subjectMap [ rr:template "http://example.org/card_games/{id}" ; rr:class ex:sets ] ;

    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/id> ; rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ] ;
        rdfs:label "id"@en ;
        rdfs:comment "unique id identifying this set"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/baseSetSize> ; rr:objectMap [ rr:column "baseSetSize" ; rr:datatype xsd:string ] ;
        rdfs:label "base Set Size"@en ;
        rdfs:comment "The number of cards in the set."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/block> ; rr:objectMap [ rr:column "block" ; rr:datatype xsd:string ] ;
        rdfs:label "block"@en ;
        rdfs:comment "The block name the set was in."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/booster> ; rr:objectMap [ rr:column "booster" ; rr:datatype xsd:string ] ;
        rdfs:label "booster"@en ;
        rdfs:comment "A breakdown of possibilities and weights of cards in a booster pack."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/code> ; rr:objectMap [ rr:column "code" ; rr:datatype xsd:string ] ;
        rdfs:label "code"@en ;
        rdfs:comment "The set code for the set."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/isFoilOnly> ; rr:objectMap [ rr:column "isFoilOnly" ; rr:datatype xsd:string ] ;
        rdfs:label "is Foil Only"@en ;
        rdfs:comment "If the set is only available in foil."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/isForeignOnly> ; rr:objectMap [ rr:column "isForeignOnly" ; rr:datatype xsd:string ] ;
        rdfs:label "is Foreign Only"@en ;
        rdfs:comment "If the set is available only outside the United States of America."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/isNonFoilOnly> ; rr:objectMap [ rr:column "isNonFoilOnly" ; rr:datatype xsd:string ] ;
        rdfs:label "is Non Foil Only"@en ;
        rdfs:comment "If the set is only available in non-foil."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/isOnlineOnly> ; rr:objectMap [ rr:column "isOnlineOnly" ; rr:datatype xsd:string ] ;
        rdfs:label "is Online Only"@en ;
        rdfs:comment "If the set is only available in online game variations."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/isPartialPreview> ; rr:objectMap [ rr:column "isPartialPreview" ; rr:datatype xsd:string ] ;
        rdfs:label "is Partial Preview"@en ;
        rdfs:comment "If the set is still in preview (spoiled). Preview sets do not have complete data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/keyruneCode> ; rr:objectMap [ rr:column "keyruneCode" ; rr:datatype xsd:string ] ;
        rdfs:label "keyrune Code"@en ;
        rdfs:comment "The matching Keyrune code for set image icons."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/mcmId> ; rr:objectMap [ rr:column "mcmId" ; rr:datatype xsd:string ] ;
        rdfs:label "magic card market id"@en ;
        rdfs:comment "The Magic Card Marketset identifier."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/mcmIdExtras> ; rr:objectMap [ rr:column "mcmIdExtras" ; rr:datatype xsd:string ] ;
        rdfs:label "magic card market ID Extras"@en ;
        rdfs:comment "The split Magic Card Market set identifier if a set is printed in two sets. This identifier represents the second set's identifier."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/mcmName> ; rr:objectMap [ rr:column "mcmName" ; rr:datatype xsd:string ] ;
        rdfs:label "magic card market name"@en ;
        rdfs:comment "magic card market name"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/mtgoCode> ; rr:objectMap [ rr:column "mtgoCode" ; rr:datatype xsd:string ] ;
        rdfs:label "magic the gathering online code"@en ;
        rdfs:comment "The set code for the set as it appears on Magic: The Gathering Online. commonsense evidence: if the value is null or empty, then it doesn't appear on Magic: The Gathering Online"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/name> ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ;
        rdfs:label "name"@en ;
        rdfs:comment "The name of the set."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/parentCode> ; rr:objectMap [ rr:column "parentCode" ; rr:datatype xsd:string ] ;
        rdfs:label "parent Code"@en ;
        rdfs:comment "The parent set code for set variations like promotions, guild kits, etc."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/releaseDate> ; rr:objectMap [ rr:column "releaseDate" ; rr:datatype xsd:string ] ;
        rdfs:label "release Date"@en ;
        rdfs:comment "The release date in ISO 8601 format for the set."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/tcgplayerGroupId> ; rr:objectMap [ rr:column "tcgplayerGroupId" ; rr:datatype xsd:string ] ;
        rdfs:label "tcg player Group Id"@en ;
        rdfs:comment "The group identifier of the set on TCGplayer"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/totalSetSize> ; rr:objectMap [ rr:column "totalSetSize" ; rr:datatype xsd:string ] ;
        rdfs:label "total Set Size"@en ;
        rdfs:comment "The total number of cards in the set, including promotional and related supplemental products but excluding Alchemy modifications - however those cards are included in the set itself."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/sets/type> ; rr:objectMap [ rr:column "type" ; rr:datatype xsd:string ] ;
        rdfs:label "type"@en ;
        rdfs:comment "The expansion type of the set.. \"alchemy\", \"archenemy\", \"arsenal\", \"box\", \"commander\", \"core\", \"draft_innovation\", \"duel_deck\", \"expansion\", \"from_the_vault\", \"funny\", \"masterpiece\", \"masters\", \"memorabilia\", \"planechase\", \"premium_deck\", \"promo\", \"spellbook\", \"starter\", \"token\", \"treasure_chest\", \"vanguard\""@en ] .
