    rr:predicateObjectMap [ rr:predicate <http://example.org/foreign_data/refers_to_cards> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/card_games/cards> ; rr:joinCondition [ rr:child "uuid" ; rr:parent "uuid" ] ] ] .

