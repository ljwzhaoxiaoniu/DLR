        rdfs:label "variations"@en ;
        rdfs:comment "variations"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/cards/watermark> ; rr:objectMap [ rr:column "watermark" ; rr:datatype xsd:string ] ;
        rdfs:label "watermark"@en ;
        rdfs:comment "The name of the watermark on the card."@en ] .

# === Table: card_games.foreign_data (pk=id) ===
