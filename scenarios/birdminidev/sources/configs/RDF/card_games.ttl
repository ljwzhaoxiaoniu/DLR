        rdfs:label "hand"@en ;
        rdfs:comment "The starting maximum hand size total modifier.. A + or - character precedes an integer. commonsense evidence: positive maximum hand size: +1, +2, .... negative maximum hand size: -1, .... neural maximum hand size: 0...."@en ] ;
