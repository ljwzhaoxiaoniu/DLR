# === Table: card_games.set_translations (pk=id) ===
<http://example.org/tm/card_games/set_translations> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "set_translations" ] ;
    rr:subjectMap [ rr:template "http://example.org/card_games/{id}" ; rr:class ex:set_translations ] ;





