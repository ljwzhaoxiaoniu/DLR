# === Table: card_games.cards (pk=id) ===
<http://example.org/tm/card_games/cards> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "cards" ] ;
    rr:subjectMap [ rr:template "http://example.org/card_games/{id}" ; rr:class ex:cards ] ;





    rr:predicateObjectMap [ rr:predicate <http://example.org/cards/id> ; rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ] ;
        rdfs:label "unique id number identifying the cards"@en ;
