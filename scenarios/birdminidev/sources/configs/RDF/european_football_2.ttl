# === Table: european_football_2.Player (pk=id) ===
<http://example.org/tm/european_football_2/Player> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Player" ] ;
    rr:subjectMap [ rr:template "http://example.org/european_football_2/{id}" ; rr:class ex:Player ] ;





    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/id> ; rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ] ;
        rdfs:label "id"@en ;
        rdfs:comment "the unique id for players"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/player_api_id> ; rr:objectMap [ rr:column "player_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "player api id"@en ;
        rdfs:comment "the id of the player api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/player_name> ; rr:objectMap [ rr:column "player_name" ; rr:datatype xsd:string ] ;
        rdfs:label "player name"@en ;
        rdfs:comment "player name"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/player_fifa_api_id> ; rr:objectMap [ rr:column "player_fifa_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "player federation international football association api id"@en ;
        rdfs:comment "the id of the player fifa api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/birthday> ; rr:objectMap [ rr:column "birthday" ; rr:datatype xsd:string ] ;
        rdfs:label "birthday"@en ;
        rdfs:comment "the player's birthday. e.g. 1992-02-29 00:00:00 commonsense reasoning: Player A is older than player B means that A's birthday is earlier than B's"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/height> ; rr:objectMap [ rr:column "height" ; rr:datatype xsd:string ] ;
        rdfs:label "height"@en ;
        rdfs:comment "the player's height"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player/weight> ; rr:objectMap [ rr:column "weight" ; rr:datatype xsd:string ] ;
        rdfs:label "weight"@en ;
        rdfs:comment "the player's weight"@en ] .

# === Table: european_football_2.Player_Attributes (pk=id) ===
<http://example.org/tm/european_football_2/Player_Attributes> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Player_Attributes" ] ;
    rr:subjectMap [ rr:template "http://example.org/european_football_2/{id}" ; rr:class ex:Player_Attributes ] ;





    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/id> ; rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ] ;
        rdfs:label "id"@en ;
        rdfs:comment "the unique id for players"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/player_fifa_api_id> ; rr:objectMap [ rr:column "player_fifa_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "player federation international football association api id"@en ;
        rdfs:comment "the id of the player fifa api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/player_api_id> ; rr:objectMap [ rr:column "player_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "player api id"@en ;
        rdfs:comment "the id of the player api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/date> ; rr:objectMap [ rr:column "date" ; rr:datatype xsd:string ] ;
        rdfs:label "date"@en ;
        rdfs:comment "date. e.g. 2016-02-18 00:00:00"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/overall_rating> ; rr:objectMap [ rr:column "overall_rating" ; rr:datatype xsd:string ] ;
        rdfs:label "overall_rating"@en ;
        rdfs:comment "the overall rating of the player. commonsense reasoning: The rating is between 0-100 which is calculated by FIFA. Higher overall rating means the player has a stronger overall strength."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/potential> ; rr:objectMap [ rr:column "potential" ; rr:datatype xsd:string ] ;
        rdfs:label "potential"@en ;
        rdfs:comment "potential of the player. commonsense reasoning: The potential score is between 0-100 which is calculated by FIFA. Higher potential score means that the player has more potential"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/preferred_foot> ; rr:objectMap [ rr:column "preferred_foot" ; rr:datatype xsd:string ] ;
        rdfs:label "preferred foot"@en ;
        rdfs:comment "the player's preferred foot when attacking. right/ left"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/attacking_work_rate> ; rr:objectMap [ rr:column "attacking_work_rate" ; rr:datatype xsd:string ] ;
        rdfs:label "attacking work rate"@en ;
        rdfs:comment "the player's attacking work rate. commonsense reasoning:  high: implies that the player is going to be in all of your attack moves  medium: implies that the player will select the attack actions he will join in  low: remain in his position while the team attacks"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/defensive_work_rate> ; rr:objectMap [ rr:column "defensive_work_rate" ; rr:datatype xsd:string ] ;
        rdfs:label "defensive_work_rate"@en ;
        rdfs:comment "the player's defensive work rate. commonsense reasoning:  high: remain in his position and defense while the team attacks  medium: implies that the player will select the defensive actions he will join in  low: implies that the player is going to be in all of your attack moves instead of defensing"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/crossing> ; rr:objectMap [ rr:column "crossing" ; rr:datatype xsd:string ] ;
        rdfs:label "crossing"@en ;
        rdfs:comment "the player's crossing score. commonsense reasoning: Cross is a long pass into the opponent's goal towards the header of sixth-yard teammate. The crossing score is between 0-100 which measures the tendency/frequency of crosses in the box. Higher potential score means that the player performs better in crossing actions."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/finishing> ; rr:objectMap [ rr:column "finishing" ; rr:datatype xsd:string ] ;
        rdfs:label "finishing"@en ;
        rdfs:comment "the player's finishing rate. 0-100 which is calculated by FIFA"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Player_Attributes/heading_accuracy> ; rr:objectMap [ rr:column "heading_accuracy" ; rr:datatype xsd:string ] ;
