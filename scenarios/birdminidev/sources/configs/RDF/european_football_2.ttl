# === Table: european_football_2.Team (pk=id) ===
<http://example.org/tm/european_football_2/Team> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "Team" ] ;
    rr:subjectMap [ rr:template "http://example.org/european_football_2/{id}" ; rr:class ex:Team ] ;





    rr:predicateObjectMap [ rr:predicate <http://example.org/Team/id> ; rr:objectMap [ rr:column "id" ; rr:datatype xsd:string ] ;
        rdfs:label "id"@en ;
        rdfs:comment "the unique id for teams"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Team/team_api_id> ; rr:objectMap [ rr:column "team_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "team api id"@en ;
        rdfs:comment "the id of the team api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Team/team_fifa_api_id> ; rr:objectMap [ rr:column "team_fifa_api_id" ; rr:datatype xsd:string ] ;
        rdfs:label "team federation international football association api id"@en ;
        rdfs:comment "the id of the team fifa api"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Team/team_long_name> ; rr:objectMap [ rr:column "team_long_name" ; rr:datatype xsd:string ] ;
        rdfs:label "team long name"@en ;
        rdfs:comment "the team's long name"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Team/team_short_name> ; rr:objectMap [ rr:column "team_short_name" ; rr:datatype xsd:string ] ;
        rdfs:label "team short name"@en ;
        rdfs:comment "the team's short name"@en ] .

