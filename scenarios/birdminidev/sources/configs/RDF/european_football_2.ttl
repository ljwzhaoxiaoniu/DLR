        rdfs:label "build Up Play Speed Class"@en ;
        rdfs:comment "the speed class. commonsense reasoning:  Slow: 1-33  Balanced: 34-66  Fast: 66-100"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/Team_Attributes/buildUpPlayDribbling> ; rr:objectMap [ rr:column "buildUpPlayDribbling" ; rr:datatype xsd:string ] ;
