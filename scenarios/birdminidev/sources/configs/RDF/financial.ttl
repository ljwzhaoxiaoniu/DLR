# === Table: financial.account (pk=account_id) ===
<http://example.org/tm/financial/account> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "account" ] ;
    rr:subjectMap [ rr:template "http://example.org/financial/{account_id}" ; rr:class ex:account ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/account/account_id> ; rr:objectMap [ rr:column "account_id" ; rr:datatype xsd:string ] ;
        rdfs:label "account id"@en ;
        rdfs:comment "the id of the account"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/account/district_id> ; rr:objectMap [ rr:column "district_id" ; rr:datatype xsd:string ] ;
        rdfs:label "location of branch"@en ;
        rdfs:comment "location of branch"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/account/frequency> ; rr:objectMap [ rr:column "frequency" ; rr:datatype xsd:string ] ;
        rdfs:label "frequency"@en ;
        rdfs:comment "frequency of the acount"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/account/date> ; rr:objectMap [ rr:column "date" ; rr:datatype xsd:string ] ;
        rdfs:label "date"@en ;
        rdfs:comment "the creation date of the account. in the form YYMMDD"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/account/refers_to_district> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/financial/district> ; rr:joinCondition [ rr:child "district_id" ; rr:parent "district_id" ] ] ] .

