    rr:logicalTable [ rr:tableName "schools" ] ;
    rr:subjectMap [ rr:template "http://example.org/california_schools/{CDSCode}" ; rr:class ex:schools ] ;

    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/CDSCode> ; rr:objectMap [ rr:column "CDSCode" ; rr:datatype xsd:string ] ;
        rdfs:label "CDSCode"@en ;
        rdfs:comment "CDSCode"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/NCESDist> ; rr:objectMap [ rr:column "NCESDist" ; rr:datatype xsd:string ] ;
        rdfs:label "National Center for Educational Statistics school district identification number"@en ;
        rdfs:comment "This field represents the 7-digit National Center for Educational Statistics (NCES) school district identification number. The first 2 digits identify the state and the last 5 digits identify the school district. Combined, they make a unique 7-digit ID for each school district."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/NCESSchool> ; rr:objectMap [ rr:column "NCESSchool" ; rr:datatype xsd:string ] ;
        rdfs:label "National Center for Educational Statistics school identification number"@en ;
        rdfs:comment "This field represents the 5-digit NCES school identification number. The NCESSchool combined with the NCESDist form a unique 12-digit ID for each school."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/StatusType> ; rr:objectMap [ rr:column "StatusType" ; rr:datatype xsd:string ] ;
        rdfs:label "StatusType"@en ;
        rdfs:comment "This field identifies the status of the district.. Definitions of the valid status types are listed below: · Active: The district is in operation and providing instructional services. · Closed: The district is not in operation and no longer providing instructional services. · Merged: The district has combined with another district or districts. · Pending: The district has not opened for operation and instructional services yet, but plans to open within the next 9–12 months."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/County> ; rr:objectMap [ rr:column "County" ; rr:datatype xsd:string ] ;
        rdfs:label "County"@en ;
        rdfs:comment "County name"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/District> ; rr:objectMap [ rr:column "District" ; rr:datatype xsd:string ] ;
        rdfs:label "District"@en ;
        rdfs:comment "District"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/School> ; rr:objectMap [ rr:column "School" ; rr:datatype xsd:string ] ;
        rdfs:label "School"@en ;
        rdfs:comment "School"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Street> ; rr:objectMap [ rr:column "Street" ; rr:datatype xsd:string ] ;
        rdfs:label "Street"@en ;
        rdfs:comment "Street"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/StreetAbr> ; rr:objectMap [ rr:column "StreetAbr" ; rr:datatype xsd:string ] ;
        rdfs:label "street address"@en ;
        rdfs:comment "The abbreviated street address of the school, district, or administrative authority’s physical location.. The abbreviated street address of the school, district, or administrative authority’s physical location. Note: Some records (primarily records of closed or retired schools) may not have data in this field."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/City> ; rr:objectMap [ rr:column "City" ; rr:datatype xsd:string ] ;
        rdfs:label "City"@en ;
        rdfs:comment "City"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Zip> ; rr:objectMap [ rr:column "Zip" ; rr:datatype xsd:string ] ;
        rdfs:label "Zip"@en ;
        rdfs:comment "Zip"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/State> ; rr:objectMap [ rr:column "State" ; rr:datatype xsd:string ] ;
        rdfs:label "State"@en ;
        rdfs:comment "State"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/MailStreet> ; rr:objectMap [ rr:column "MailStreet" ; rr:datatype xsd:string ] ;
        rdfs:label "MailStreet"@en ;
        rdfs:comment "MailStreet. The unabbreviated mailing address of the school, district, or administrative authority. Note: 1) Some entities (primarily closed or retired schools) may not have data in this field; 2) Many active entities have not provided a mailing street address. For your convenience we have filled the unpopulated MailStreet cells with Street data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/MailStrAbr> ; rr:objectMap [ rr:column "MailStrAbr" ; rr:datatype xsd:string ] ;
        rdfs:label "mailing street address"@en ;
        rdfs:comment "mailing street address. the abbreviated mailing street address of the school, district, or administrative authority.Note: Many active entities have not provided a mailing street address. For your convenience we have filled the unpopulated MailStrAbr cells with StreetAbr data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/MailCity> ; rr:objectMap [ rr:column "MailCity" ; rr:datatype xsd:string ] ;
        rdfs:label "mailing city"@en ;
        rdfs:comment "mailing city. The city associated with the mailing address of the school, district, or administrative authority. Note: Many entities have not provided a mailing address city. For your convenience we have filled the unpopulated MailCity cells with City data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/MailZip> ; rr:objectMap [ rr:column "MailZip" ; rr:datatype xsd:string ] ;
        rdfs:label "mailing zip"@en ;
        rdfs:comment "mailing zip. The zip code associated with the mailing address of the school, district, or administrative authority. Note: Many entities have not provided a mailing address zip code. For your convenience we have filled the unpopulated MailZip cells with Zip data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/MailState> ; rr:objectMap [ rr:column "MailState" ; rr:datatype xsd:string ] ;
        rdfs:label "mailing state"@en ;
        rdfs:comment "mailing state. The state within the mailing address. For your convenience we have filled the unpopulated MailState cells with State data."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Phone> ; rr:objectMap [ rr:column "Phone" ; rr:datatype xsd:string ] ;
        rdfs:label "Phone"@en ;
        rdfs:comment "Phone"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Ext> ; rr:objectMap [ rr:column "Ext" ; rr:datatype xsd:string ] ;
        rdfs:label "extension"@en ;
        rdfs:comment "The phone number extension of the school, district, or administrative authority.. The phone number extension of the school, district, or administrative authority."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Website> ; rr:objectMap [ rr:column "Website" ; rr:datatype xsd:string ] ;
        rdfs:label "Website"@en ;
        rdfs:comment "The website address of the school, district, or administrative authority.. The website address of the school, district, or administrative authority."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/OpenDate> ; rr:objectMap [ rr:column "OpenDate" ; rr:datatype xsd:string ] ;
        rdfs:label "OpenDate"@en ;
        rdfs:comment "The date the school opened."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/ClosedDate> ; rr:objectMap [ rr:column "ClosedDate" ; rr:datatype xsd:string ] ;
        rdfs:label "ClosedDate"@en ;
        rdfs:comment "The date the school closed."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Charter> ; rr:objectMap [ rr:column "Charter" ; rr:datatype xsd:string ] ;
        rdfs:label "Charter"@en ;
        rdfs:comment "This field identifies a charter school.. The field is coded as follows: · 1 = The school is a charter · 0 = The school is not a charter"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/CharterNum> ; rr:objectMap [ rr:column "CharterNum" ; rr:datatype xsd:string ] ;
        rdfs:label "CharterNum"@en ;
        rdfs:comment "The charter school number,. 4-digit number assigned to a charter school."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/FundingType> ; rr:objectMap [ rr:column "FundingType" ; rr:datatype xsd:string ] ;
        rdfs:label "FundingType"@en ;
        rdfs:comment "Indicates the charter school funding type. Values are as follows: · Not in CS (California School) funding model · Locally funded · Directly funded"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/DOC> ; rr:objectMap [ rr:column "DOC" ; rr:datatype xsd:string ] ;
        rdfs:label "District Ownership Code"@en ;
        rdfs:comment "District Ownership Code. The District Ownership Code (DOC) is the numeric code used to identify the category of the Administrative Authority. • 00 - County Office of Education • 02 – State Board of Education • 03 – Statewide Benefit Charter • 31 – State Special Schools • 34 – Non-school Location* • 52 – Elementary School District • 54 – Unified School District • 56 – High School District • 98 – Regional Occupational Center/Program (ROC/P) commonsense evidence: *Only the California Education Authority has been included in the non-school location category."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/DOCType> ; rr:objectMap [ rr:column "DOCType" ; rr:datatype xsd:string ] ;
        rdfs:label "The District Ownership Code Type"@en ;
        rdfs:comment "The District Ownership Code Type is the text description of the DOC category.. (See text values in DOC field description above)"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/SOC> ; rr:objectMap [ rr:column "SOC" ; rr:datatype xsd:string ] ;
        rdfs:label "School Ownership Code"@en ;
        rdfs:comment "The School Ownership Code is a numeric code used to identify the type of school.. • 08 - Preschool • 09 – Special Education Schools (Public) • 11 – Youth Authority Facilities (CEA) • 13 – Opportunity Schools • 14 – Juvenile Court Schools • 15 – Other County or District Programs • 31 – State Special Schools • 60 – Elementary School (Public) • 61 – Elementary School in 1 School District (Public) • 62 – Intermediate/Middle Schools (Public) • 63 – Alternative Schools of Choice • 64 – Junior High Schools (Public) • 65 – K-12 Schools (Public) • 66 – High Schools (Public) • 67 – High Schools in 1 School District (Public) • 68 – Continuation High Schools • 69 – District Community Day Schools • 70 – Adult Education Centers • 98 – Regional Occupational Center/Program (ROC/P)"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/SOCType> ; rr:objectMap [ rr:column "SOCType" ; rr:datatype xsd:string ] ;
        rdfs:label "School Ownership Code Type"@en ;
        rdfs:comment "The School Ownership Code Type is the text description of the type of school.. The School Ownership Code Type is the text description of the type of school."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/EdOpsCode> ; rr:objectMap [ rr:column "EdOpsCode" ; rr:datatype xsd:string ] ;
        rdfs:label "Education Option Code"@en ;
        rdfs:comment "The Education Option Code is a short text description of the type of education offered.. • ALTSOC – Alternative School of Choice • COMM – County Community School • COMMDAY – Community Day School • CON – Continuation School • JUV – Juvenile Court School • OPP – Opportunity School • YTH – Youth Authority School • SSS – State Special School • SPEC – Special Education School • TRAD – Traditional • ROP – Regional Occupational Program • HOMHOS – Home and Hospital • SPECON – District Consortia Special Education School"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/EdOpsName> ; rr:objectMap [ rr:column "EdOpsName" ; rr:datatype xsd:string ] ;
        rdfs:label "Educational Option Name"@en ;
        rdfs:comment "Educational Option Name. The Educational Option Name is the long text description of the type of education being offered."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/EILCode> ; rr:objectMap [ rr:column "EILCode" ; rr:datatype xsd:string ] ;
        rdfs:label "Educational Instruction Level Code"@en ;
        rdfs:comment "The Educational Instruction Level Code is a short text description of the institution's type relative to the grade range served.. • A – Adult • ELEM – Elementary • ELEMHIGH – Elementary-High Combination • HS – High School • INTMIDJR – Intermediate/Middle/Junior High • PS – Preschool • UG – Ungraded"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/EILName> ; rr:objectMap [ rr:column "EILName" ; rr:datatype xsd:string ] ;
        rdfs:label "Educational Instruction Level Name"@en ;
        rdfs:comment "The Educational Instruction Level Name is the long text description of the institution’s type relative to the grade range served.. The Educational Instruction Level Name is the long text description of the institution’s type relative to the grade range served."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/GSoffered> ; rr:objectMap [ rr:column "GSoffered" ; rr:datatype xsd:string ] ;
        rdfs:label "grade span offered"@en ;
        rdfs:comment "The grade span offered is the lowest grade and the highest grade offered or supported by the school, district, or administrative authority. This field might differ from the grade span served as reported in the most recent certified California Longitudinal Pupil Achievement (CALPADS) Fall 1 data collection.. For example XYZ School might display the following data: GSoffered = P–Adult GSserved = K–12"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/GSserved> ; rr:objectMap [ rr:column "GSserved" ; rr:datatype xsd:string ] ;
        rdfs:label "grade span served."@en ;
        rdfs:comment "It is the lowest grade and the highest grade of student enrollment as reported in the most recent certified CALPADS Fall 1 data collection. Only K–12 enrollment is reported through CALPADS. This field may differ from the grade span offered.. commonsense evidence: 1. Only K–12 enrollment is reported through CALPADS 2. Note: Special programs at independent study, alternative education, and special education schools will often exceed the typical grade span for schools of that type"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Virtual> ; rr:objectMap [ rr:column "Virtual" ; rr:datatype xsd:string ] ;
        rdfs:label "Virtual"@en ;
        rdfs:comment "This field identifies the type of virtual instruction offered by the school. Virtual instruction is instruction in which students and teachers are separated by time and/or location, and interaction occurs via computers and/or telecommunications technologies.. The field is coded as follows: · F = Exclusively Virtual – The school has no physical building where students meet with each other or with teachers, all instruction is virtual. · V = Primarily Virtual – The school focuses on a systematic program of virtual instruction but includes some physical meetings among students or with teachers. · C = Primarily Classroom – The school offers virtual courses but virtual instruction is not the primary means of instruction. · N = Not Virtual – The school does not offer any virtual instruction. · P = Partial Virtual – The school offers some, but not all, instruction through virtual instruction. Note: This value was retired and replaced with the Primarily Virtual and Primarily Classroom values beginning with the 2016–17 school year."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Magnet> ; rr:objectMap [ rr:column "Magnet" ; rr:datatype xsd:string ] ;
        rdfs:label "Magnet"@en ;
        rdfs:comment "This field identifies whether a school is a magnet school and/or provides a magnet program.. The field is coded as follows: · 1 = Magnet - The school is a magnet school and/or offers a magnet program. · 0 = Not Magnet - The school is not a magnet school and/or does not offer a magnet program. commonsense evidence: Note: Preschools and adult education centers do not contain a magnet school indicator."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Latitude> ; rr:objectMap [ rr:column "Latitude" ; rr:datatype xsd:string ] ;
        rdfs:label "Latitude"@en ;
        rdfs:comment "The angular distance (expressed in degrees) between the location of the school, district, or administrative authority and the equator measured north to south.. The angular distance (expressed in degrees) between the location of the school, district, or administrative authority and the equator measured north to south."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/Longitude> ; rr:objectMap [ rr:column "Longitude" ; rr:datatype xsd:string ] ;
        rdfs:label "Longitude"@en ;
        rdfs:comment "The angular distance (expressed in degrees) between the location of the school, district, or administrative authority and the prime meridian (Greenwich, England) measured from west to east.. The angular distance (expressed in degrees) between the location of the school, district, or administrative authority and the prime meridian (Greenwich, England) measured from west to east."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/schools/AdmFName1> ; rr:objectMap [ rr:column "AdmFName1" ; rr:datatype xsd:string ] ;
        rdfs:label "administrator's first name"@en ;
        rdfs:comment "administrator's first name. The superintendent’s or principal’s first name. commonsense evidence: Only active and pending districts and schools will display administrator information, if applicable."@en ] ;
