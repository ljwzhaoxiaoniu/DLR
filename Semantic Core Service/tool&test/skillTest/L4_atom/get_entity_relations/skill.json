{
  "name": "get_entity_relations",
  "name_zh": "获取实体关联关系",
  "version": "1.0.0",
  "is_system_tool": false,
  "description": "【获取实体与其他实体的关联关系】：根据实体ID，查询该实体与其他哪些实体有关联（如：台区线损明细归属变压器、影响用户档案等），不涉及该实体自身的属性字段。",
  "description_zh": "【获取实体与其他实体的关联关系】：根据实体ID，查询该实体与其他哪些实体有关联（如：台区线损明细归属变压器、影响用户档案等），不涉及该实体自身的属性字段。",
  "layer": "L4",
  "type": "atom",
  "category": "data_query",
  "usage_guide": "【重要】此技能只用于获取实体与其他实体的关联关系。如果需要知道该实体自身有哪些属性字段，请使用 get_entity_attributes 技能。",
  "usage_guide_zh": "【重要】此技能只用于获取实体与其他实体的关联关系。如果需要知道该实体自身有哪些属性字段，请使用 get_entity_attributes 技能。",
  "inputs": [
    {
      "name": "entity_id",
      "type": "string",
      "description": "业务实体的唯一标识符（如 MDAS.台区线损明细）",
      "description_zh": "业务实体的唯一标识符（如 MDAS.台区线损明细）",
      "required": true
    },
    {
      "name": "semantic_service_url",
      "type": "string",
      "description": "语义服务的URL地址",
      "description_zh": "语义服务的URL地址",
      "required": false,
      "default": "http://localhost:28765"
    }
  ],
  "outputs": [
    {
      "name": "success",
      "type": "boolean",
      "description": "查询是否成功",
      "description_zh": "查询是否成功"
    },
    {
      "name": "entity_id",
      "type": "string",
      "description": "实体ID",
      "description_zh": "实体ID"
    },
    {
      "name": "name",
      "type": "string",
      "description": "实体名称",
      "description_zh": "实体名称"
    },
    {
      "name": "relations",
      "type": "array",
      "description": "关联关系列表",
      "description_zh": "关联关系列表"
    },
    {
      "name": "formatted_result",
      "type": "string",
      "description": "格式化的查询结果",
      "description_zh": "格式化的查询结果"
    }
  ],
  "examples": [
    {
      "input": {"entity_id": "MDAS.台区线损明细"},
      "output": {
        "success": true,
        "entity_id": "MDAS.台区线损明细",
        "name": "台区线损明细",
        "relations": [
          {"relation_name": "归属", "target_entity_name": "变压器", "target_entity_id": "PMS.变压器"},
          {"relation_name": "影响", "target_entity_name": "用户档案", "target_entity_id": "PWMK.用户档案"}
        ],
        "formatted_result": "实体【台区线损明细】的关联关系：归属→变压器，影响→用户档案"
      }
    }
  ]
}
