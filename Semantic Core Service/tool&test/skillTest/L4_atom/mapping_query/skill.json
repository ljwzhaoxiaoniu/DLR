{
  "name": "mapping_query",
  "name_zh": "物理映射查询",
  "version": "1.0.0",
  "description": "根据实体ID查询物理映射信息：数据库、表名、字段映射",
  "description_zh": "根据实体ID查询物理映射信息：数据库、表名、字段映射",
  "layer": "L4",
  "type": "atom",
  "category": "metadata",
  "usage_guide": "当需要获取语义实体对应的物理存储信息时使用此工具。输入实体ID列表，输出每个实体对应的数据库名称、物理表名、字段映射关系等。",
  "usage_guide_zh": "当需要获取语义实体对应的物理存储信息时使用此工具。输入实体ID列表，输出每个实体对应的数据库名称、物理表名、字段映射关系等。",
  "inputs": [
    {
      "name": "entity_ids",
      "type": "array",
      "description": "实体ID列表，例如 [\"PMS.变压器\"]",
      "description_zh": "实体ID列表",
      "required": true
    },
    {
      "name": "semantic_service_url",
      "type": "string",
      "description": "语义元数据平台服务地址",
      "description_zh": "语义元数据平台服务地址",
      "default": "http://localhost:28765",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "success",
      "type": "boolean",
      "description": "查询是否成功",
      "description_zh": "查询是否成功"
    },
    {
      "name": "mappings",
      "type": "array",
      "description": "物理映射列表，每个映射包含 entity_id, database, physical_table, attributes",
      "description_zh": "物理映射列表"
    },
    {
      "name": "formatted_result",
      "type": "string",
      "description": "格式化的映射结果",
      "description_zh": "格式化的映射结果"
    }
  ],
  "examples": [
    {
      "input": {"entity_ids": ["PMS.变压器"]},
      "output": {
        "success": true,
        "mappings": [
          {
            "entity_id": "PMS.变压器",
            "database": "PMS",
            "physical_table": "变压器档案",
            "attributes": {
              "变压器ID": {"physical_column": "变压器ID", "data_type": "string"},
              "额定容量": {"physical_column": "额定容量", "data_type": "string"}
            }
          }
        ],
        "formatted_result": "实体 PMS.变压器 映射到 PMS 数据库的 变压器档案 表"
      }
    }
  ]
}
