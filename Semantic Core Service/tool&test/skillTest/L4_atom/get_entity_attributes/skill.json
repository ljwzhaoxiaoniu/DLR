{
  "name": "get_entity_attributes",
  "name_zh": "获取实体属性",
  "version": "1.0.0",
  "is_system_tool": false,
  "description": "【获取单个实体自身的属性】：根据实体ID，查询该实体本身有哪些属性字段（如台区ID、线损电量、用户编号等），不涉及与其他实体的关联关系。",
  "description_zh": "【获取单个实体自身的属性】：根据实体ID，查询该实体本身有哪些属性字段（如台区ID、线损电量、用户编号等），不涉及与其他实体的关联关系。",
  "layer": "L4",
  "type": "atom",
  "category": "data_query",
  "usage_guide": "【重要】此技能只用于获取单个实体自身的属性字段。如果需要知道该实体与其他实体的关联关系，请使用 get_entity_relations 技能。",
  "usage_guide_zh": "【重要】此技能只用于获取单个实体自身的属性字段。如果需要知道该实体与其他实体的关联关系，请使用 get_entity_relations 技能。",
  "inputs": [
    {
      "name": "entity_id",
      "type": "string",
      "description": "业务实体的唯一标识符（如 MDAS.台区线损明细）",
      "description_zh": "业务实体的唯一标识符（如 MDAS.台区线损明细）",
      "required": true
    },
    {
      "name": "semantic_service_url",
      "type": "string",
      "description": "语义服务的URL地址",
      "description_zh": "语义服务的URL地址",
      "required": false,
      "default": "http://localhost:28765"
    }
  ],
  "outputs": [
    {
      "name": "success",
      "type": "boolean",
      "description": "查询是否成功",
      "description_zh": "查询是否成功"
    },
    {
      "name": "entity_id",
      "type": "string",
      "description": "实体ID",
      "description_zh": "实体ID"
    },
    {
      "name": "name",
      "type": "string",
      "description": "实体名称",
      "description_zh": "实体名称"
    },
    {
      "name": "description",
      "type": "string",
      "description": "实体描述",
      "description_zh": "实体描述"
    },
    {
      "name": "source_table",
      "type": "string",
      "description": "来源物理表",
      "description_zh": "来源物理表"
    },
    {
      "name": "attributes",
      "type": "array",
      "description": "属性列表",
      "description_zh": "属性列表"
    },
    {
      "name": "formatted_result",
      "type": "string",
      "description": "格式化的查询结果",
      "description_zh": "格式化的查询结果"
    }
  ],
  "examples": [
    {
      "input": {"entity_id": "MDAS.台区线损明细"},
      "output": {
        "success": true,
        "entity_id": "MDAS.台区线损明细",
        "name": "台区线损明细",
        "description": "记录台区线损的每日统计数据",
        "source_table": "mdas_line_loss_detail",
        "attributes": [
          {"attribute_name": "台区ID", "attribute_type": "字符串"},
          {"attribute_name": "线损电量", "attribute_type": "数值"}
        ],
        "formatted_result": "实体【台区线损明细】(MDAS.台区线损明细)的属性：台区ID、线损电量..."
      }
    }
  ]
}
