# ===== student_club =====
# FIX: attendance->member, attendance->event, expense->member, expense->budget, 
#   member->zip_code, member->major

TM_student_club_member a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "member" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/member/{member_id}" ; rr:class <student_club/社团成员> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/名> ; rr:objectMap [ rr:column "first_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/姓> ; rr:objectMap [ rr:column "last_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/职务> ; rr:objectMap [ rr:column "position" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/T恤尺码> ; rr:objectMap [ rr:column "t_shirt_size" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/电话> ; rr:objectMap [ rr:column "phone" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/邮编> ; rr:objectMap [ rr:column "zip" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/专业ID> ; rr:objectMap [ rr:column "link_to_major" ; rr:datatype xsd:string ] ] ;
  # >>> FIX: member -> zip_code
  rr:predicateObjectMap [ rr:predicate <student_club/地区归属> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_zip_code ; rr:joinCondition [ rr:child "zip" ; rr:parent "zip_code" ] ] ] ;
  # >>> FIX: member -> major
  rr:predicateObjectMap [ rr:predicate <student_club/专业归属> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_major ; rr:joinCondition [ rr:child "link_to_major" ; rr:parent "major_id" ] ] ] .

TM_student_club_event a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "event" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/event/{event_id}" ; rr:class <student_club/社团活动> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/活动名称> ; rr:objectMap [ rr:column "event_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/活动日期> ; rr:objectMap [ rr:column "event_date" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/类型> ; rr:objectMap [ rr:column "type" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/地点> ; rr:objectMap [ rr:column "location" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/状态> ; rr:objectMap [ rr:column "status" ; rr:datatype xsd:string ] ] .

TM_student_club_attendance a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "attendance" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/attendance/{link_to_event}" ; rr:class <student_club/活动出勤> ] ;
  # >>> FIX: attendance -> event
  rr:predicateObjectMap [ rr:predicate <student_club/出勤活动> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_event ; rr:joinCondition [ rr:child "link_to_event" ; rr:parent "event_id" ] ] ] ;
  # >>> FIX: attendance -> member
  rr:predicateObjectMap [ rr:predicate <student_club/出勤成员> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "link_to_member" ; rr:parent "member_id" ] ] ] .

TM_student_club_budget a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "budget" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/budget/{link_to_event}" ; rr:class <student_club/活动财务> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/预算额度> ; rr:objectMap [ rr:column "amount" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/已花费> ; rr:objectMap [ rr:column "spent" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/预算分类> ; rr:objectMap [ rr:column "category" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/剩余> ; rr:objectMap [ rr:column "remaining" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/事件状态> ; rr:objectMap [ rr:column "event_status" ; rr:datatype xsd:string ] ] ;
  # PAS: 社团活动 -> 活动财务
  rr:predicateObjectMap [ rr:predicate <student_club/预算分配> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_event ; rr:joinCondition [ rr:child "link_to_event" ; rr:parent "event_id" ] ] ] .

TM_student_club_expense a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "expense" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/expense/{link_to_budget}" ; rr:class <student_club/活动财务> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/支出描述> ; rr:objectMap [ rr:column "expense_description" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/费用> ; rr:objectMap [ rr:column "cost" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/支出日期> ; rr:objectMap [ rr:column "expense_date" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/是否批准> ; rr:objectMap [ rr:column "approved" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/经手成员> ; rr:objectMap [ rr:column "link_to_member" ; rr:datatype xsd:string ] ] ;
  # >>> FIX: expense -> budget
  rr:predicateObjectMap [ rr:predicate <student_club/支出预算> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_budget ; rr:joinCondition [ rr:child "link_to_budget" ; rr:parent "budget_id" ] ] ] ;
  # >>> FIX: expense -> member
  rr:predicateObjectMap [ rr:predicate <student_club/支出经手> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "link_to_member" ; rr:parent "member_id" ] ] ] .

TM_student_club_income a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "income" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/income/{link_to_member}" ; rr:class <student_club/资金收入> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/金额> ; rr:objectMap [ rr:column "amount" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/来源> ; rr:objectMap [ rr:column "source" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/收到日期> ; rr:objectMap [ rr:column "date_received" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/备注> ; rr:objectMap [ rr:column "notes" ; rr:datatype xsd:string ] ] ;
  # PAS: 社团成员 -> 资金收入
  rr:predicateObjectMap [ rr:predicate <student_club/资金收取> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "link_to_member" ; rr:parent "member_id" ] ] ] .

TM_student_club_major a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "major" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/major/{major_id}" ; rr:class <student_club/专业> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/专业名称> ; rr:objectMap [ rr:column "major_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/院系> ; rr:objectMap [ rr:column "department" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/学院> ; rr:objectMap [ rr:column "college" ; rr:datatype xsd:string ] ] .

TM_student_club_zip_code a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "zip_code" ] ;
  rr:subjectMap [ rr:template "http://example.org/student_club/zip_code/{zip_code}" ; rr:class <student_club/邮编区域> ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/城市> ; rr:objectMap [ rr:column "city" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/州> ; rr:objectMap [ rr:column "state" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <student_club/县> ; rr:objectMap [ rr:column "county" ; rr:datatype xsd:string ] ] .
