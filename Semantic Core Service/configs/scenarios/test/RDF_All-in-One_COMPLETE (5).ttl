# ===== european_football_2 =====
# FIX: backfilled Match->Team (home/away), Match->Player (all 22), League->Country,
#   Country entity (was completely missing)

TM_european_football_2_Player a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Player" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Player/{player_api_id}" ; rr:class <european_football_2/球员> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/姓名> ; rr:objectMap [ rr:column "player_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/生日> ; rr:objectMap [ rr:column "birthday" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/身高> ; rr:objectMap [ rr:column "height" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/体重> ; rr:objectMap [ rr:column "weight" ; rr:datatype xsd:string ] ] .

TM_european_football_2_Player_Attributes a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Player_Attributes" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Player_Attributes/{player_api_id}" ; rr:class <european_football_2/球员> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/综合评分> ; rr:objectMap [ rr:column "overall_rating" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/惯用脚> ; rr:objectMap [ rr:column "preferred_foot" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/进攻态度> ; rr:objectMap [ rr:column "attacking_work_rate" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/防守态度> ; rr:objectMap [ rr:column "defensive_work_rate" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/传中> ; rr:objectMap [ rr:column "crossing" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/射门> ; rr:objectMap [ rr:column "finishing" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/头球> ; rr:objectMap [ rr:column "heading_accuracy" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/短传> ; rr:objectMap [ rr:column "short_passing" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/凌空> ; rr:objectMap [ rr:column "volleys" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/盘带> ; rr:objectMap [ rr:column "dribbling" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/弧线> ; rr:objectMap [ rr:column "curve" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/任意球> ; rr:objectMap [ rr:column "free_kick_accuracy" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/远射> ; rr:objectMap [ rr:column "long_shots" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/冲刺速度> ; rr:objectMap [ rr:column "sprint_speed" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/评分日期> ; rr:objectMap [ rr:column "`date`" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/弹跳> ; rr:objectMap [ rr:column "jumping" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/潜力> ; rr:objectMap [ rr:column "potential" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/控球> ; rr:objectMap [ rr:column "ball_control" ; rr:datatype xsd:string ] ] .

TM_european_football_2_Team a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Team" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Team/{team_api_id}" ; rr:class <european_football_2/球队> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/全称> ; rr:objectMap [ rr:column "team_long_name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/简称> ; rr:objectMap [ rr:column "team_short_name" ; rr:datatype xsd:string ] ] .

TM_european_football_2_Team_Attributes a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Team_Attributes" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Team_Attributes/{team_api_id}" ; rr:class <european_football_2/球队> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/组织速度> ; rr:objectMap [ rr:column "buildUpPlaySpeed" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/速度分类> ; rr:objectMap [ rr:column "buildUpPlaySpeedClass" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/组织传球> ; rr:objectMap [ rr:column "buildUpPlayPassing" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/传球分类> ; rr:objectMap [ rr:column "buildUpPlayPassingClass" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/机会创造传球> ; rr:objectMap [ rr:column "chanceCreationPassing" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/机会创造分类> ; rr:objectMap [ rr:column "chanceCreationPassingClass" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/防守侵略性分类> ; rr:objectMap [ rr:column "defenceAggressionClass" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/属性日期> ; rr:objectMap [ rr:column "`date`" ; rr:datatype xsd:string ] ] .

TM_european_football_2_Match a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Match" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Match/{id}" ; rr:class <european_football_2/比赛> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/联赛ID> ; rr:objectMap [ rr:column "league_id" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/赛季> ; rr:objectMap [ rr:column "season" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队ID> ; rr:objectMap [ rr:column "home_team_api_id" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队ID> ; rr:objectMap [ rr:column "away_team_api_id" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队进球> ; rr:objectMap [ rr:column "home_team_goal" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队进球> ; rr:objectMap [ rr:column "away_team_goal" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/日期> ; rr:objectMap [ rr:column "`date`" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/国家ID> ; rr:objectMap [ rr:column "country_id" ; rr:datatype xsd:string ] ] ;
  # PAS: 联赛 -> 比赛
  rr:predicateObjectMap [ rr:predicate <european_football_2/赛事归属> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_League ; rr:joinCondition [ rr:child "league_id" ; rr:parent "id" ] ] ] ;
  # >>> FIX: Match -> Team (home_team_api_id)
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Team ; rr:joinCondition [ rr:child "home_team_api_id" ; rr:parent "team_api_id" ] ] ] ;
  # >>> FIX: Match -> Team (away_team_api_id)
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Team ; rr:joinCondition [ rr:child "away_team_api_id" ; rr:parent "team_api_id" ] ] ] ;
  # >>> FIX: Match -> Player (home_player_1..11)
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员1> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_1" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员2> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_2" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员3> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_3" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员4> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_4" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员5> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_5" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员6> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_6" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员7> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_7" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员8> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_8" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员9> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_9" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员10> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_10" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/主队球员11> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "home_player_11" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员1> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_1" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员2> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_2" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员3> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_3" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员4> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_4" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员5> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_5" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员6> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_6" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员7> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_7" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员8> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_8" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员9> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_9" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员10> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_10" ; rr:parent "player_api_id" ] ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/客队球员11> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Player ; rr:joinCondition [ rr:child "away_player_11" ; rr:parent "player_api_id" ] ] ] .

TM_european_football_2_League a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "League" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/League/{id}" ; rr:class <european_football_2/联赛> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/联赛名称> ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/国家ID> ; rr:objectMap [ rr:column "country_id" ; rr:datatype xsd:string ] ] ;
  # >>> FIX: League -> Country
  rr:predicateObjectMap [ rr:predicate <european_football_2/国家归属> ; rr:objectMap [ rr:parentTriplesMap TM_european_football_2_Country ; rr:joinCondition [ rr:child "country_id" ; rr:parent "id" ] ] ] .

# >>> FIX: Country entity (was completely missing from RDF, ER has it)
TM_european_football_2_Country a rr:TriplesMap ;
  rr:logicalTable [ rr:tableName "Country" ] ;
  rr:subjectMap [ rr:template "http://example.org/european_football_2/Country/{id}" ; rr:class <european_football_2/国家> ] ;
  rr:predicateObjectMap [ rr:predicate <european_football_2/国家名称> ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ] .
