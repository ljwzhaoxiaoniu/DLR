@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/> .

# R2RML — database: toxicology
# URL: sqlite:///D:\Code_Proj\DLR Proj\MINIDEV_sqlite\dev_databases\toxicology/toxicology.sqlite
# Tables: 4  ForeignKeys: 5
# Source: real FK constraints (PRAGMA foreign_key_list)

# === Table: toxicology.atom (pk=atom_id) ===
<http://example.org/tm/toxicology/atom> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "atom" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/{atom_id}" ; rr:class ex:atom ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/atom/molecule_id> ; rr:objectMap [ rr:column "molecule_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/atom/element> ; rr:objectMap [ rr:column "element" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/atom/refers_to_molecule> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/toxicology/molecule> ; rr:joinCondition [ rr:child "molecule_id" ; rr:parent "molecule_id" ] ] ] .

# === Table: toxicology.bond (pk=bond_id) ===
<http://example.org/tm/toxicology/bond> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "bond" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/{bond_id}" ; rr:class ex:bond ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/bond/molecule_id> ; rr:objectMap [ rr:column "molecule_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/bond/bond_type> ; rr:objectMap [ rr:column "bond_type" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/bond/refers_to_molecule> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/toxicology/molecule> ; rr:joinCondition [ rr:child "molecule_id" ; rr:parent "molecule_id" ] ] ] .

# === Table: toxicology.connected (pk=atom_id2) ===
<http://example.org/tm/toxicology/connected> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "connected" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/{atom_id2}" ; rr:class ex:connected ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/connected/atom_id> ; rr:objectMap [ rr:column "atom_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/connected/bond_id> ; rr:objectMap [ rr:column "bond_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/connected/refers_to_bond> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/toxicology/bond> ; rr:joinCondition [ rr:child "bond_id" ; rr:parent "bond_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/connected/refers_to_atom> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/toxicology/atom> ; rr:joinCondition [ rr:child "atom_id2" ; rr:parent "atom_id" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/connected/refers_to_atom> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/toxicology/atom> ; rr:joinCondition [ rr:child "atom_id" ; rr:parent "atom_id" ] ] ] .

# === Table: toxicology.molecule (pk=molecule_id) ===
<http://example.org/tm/toxicology/molecule> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "molecule" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/{molecule_id}" ; rr:class ex:molecule ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/molecule/label> ; rr:objectMap [ rr:column "label" ; rr:datatype xsd:string ] ] .

