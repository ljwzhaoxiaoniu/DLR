# === Table: debit_card_specializing.customers (pk=CustomerID) ===
<http://example.org/tm/debit_card_specializing/customers> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "customers" ] ;
    rr:subjectMap [ rr:template "http://example.org/debit_card_specializing/{CustomerID}" ; rr:class ex:customers ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/customers/CustomerID> ; rr:objectMap [ rr:column "CustomerID" ; rr:datatype xsd:string ] ;
        rdfs:label "Customer ID"@en ;
        rdfs:comment "Customer unique identifier"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/customers/Segment> ; rr:objectMap [ rr:column "Segment" ; rr:datatype xsd:string ] ;
        rdfs:label "Customer Segment"@en ;
        rdfs:comment "Customer segment: SME=Small Business, LAM=Local, KAM=Key Account"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/customers/Currency> ; rr:objectMap [ rr:column "Currency" ; rr:datatype xsd:string ] ;
        rdfs:label "Currency"@en ;
        rdfs:comment "Currency: CZK=Czech Koruna, EUR=Euro"@en ] .

