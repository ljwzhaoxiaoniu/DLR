    rr:predicateObjectMap [ rr:predicate <thrombosis_prediction/检验申请> ; rr:objectMap [ rr:parentTriplesMap TM_thrombosis_prediction_Patient ; rr:joinCondition [ rr:child "ID" ; rr:parent "ID" ] ] ] .
TM_thrombosis_prediction_Examination # PAS 患者->临床检查
    rr:predicateObjectMap [ rr:predicate <thrombosis_prediction/临床检查> ; rr:objectMap [ rr:parentTriplesMap TM_thrombosis_prediction_Patient ; rr:joinCondition [ rr:child "ID" ; rr:parent "ID" ] ] ] .

# ===== toxicology =====
TM_toxicology_molecule a rr:TriplesMap
    rr:logicalTable [ rr:tableName "molecule" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/molecule/{molecule_id}" ; rr:class <toxicology/分子> ] ;
    rr:predicateObjectMap [ rr:predicate <toxicology/致癌标签> ; rr:objectMap [ rr:column "label" ; rr:datatype xsd:string ] ] .
TM_toxicology_atom a rr:TriplesMap
    rr:logicalTable [ rr:tableName "atom" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/atom/{molecule_id}" ; rr:class <toxicology/原子> ] ;
    rr:predicateObjectMap [ rr:predicate <toxicology/元素类型> ; rr:objectMap [ rr:column "element" ; rr:datatype xsd:string ] ] .
TM_toxicology_bond a rr:TriplesMap
    rr:logicalTable [ rr:tableName "bond" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/bond/{molecule_id}" ; rr:class <toxicology/化学键> ] ;
    rr:predicateObjectMap [ rr:predicate <toxicology/键类型> ; rr:objectMap [ rr:column "bond_type" ; rr:datatype xsd:string ] ] .
TM_toxicology_connected a rr:TriplesMap
    rr:logicalTable [ rr:tableName "connected" ] ;
    rr:subjectMap [ rr:template "http://example.org/toxicology/connected/{bond_id}" ; rr:class <toxicology/化学键> ] ;
    rr:predicateObjectMap [ rr:predicate <toxicology/原子1> ; rr:objectMap [ rr:column "atom_id" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate <toxicology/原子2> ; rr:objectMap [ rr:column "atom_id2" ; rr:datatype xsd:string ] ] .
TM_toxicology_atom # PAS 分子->原子
    rr:predicateObjectMap [ rr:predicate <toxicology/原子构成> ; rr:objectMap [ rr:parentTriplesMap TM_toxicology_molecule ; rr:joinCondition [ rr:child "molecule_id" ; rr:parent "molecule_id" ] ] ] .
TM_toxicology_bond # PAS 分子->化学键
    rr:predicateObjectMap [ rr:predicate <toxicology/化学键> ; rr:objectMap [ rr:parentTriplesMap TM_toxicology_molecule ; rr:joinCondition [ rr:child "molecule_id" ; rr:parent "molecule_id" ] ] ] .
