    rr:predicateObjectMap [ rr:predicate <student_club/专业归属> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "major_id" ; rr:parent "member_id" ] ] ] .
TM_student_club_zip_code # PAS 社团成员->邮编区域
    rr:predicateObjectMap [ rr:predicate <student_club/地区归属> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "zip_code" ; rr:parent "member_id" ] ] ] .

