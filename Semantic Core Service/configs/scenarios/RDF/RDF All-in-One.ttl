    rr:predicateObjectMap [ rr:predicate <student_club/县> ; rr:objectMap [ rr:column "county" ; rr:datatype xsd:string ] ] .
TM_student_club_budget # PAS 社团活动->活动财务
    rr:predicateObjectMap [ rr:predicate <student_club/预算分配> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_event ; rr:joinCondition [ rr:child "link_to_event" ; rr:parent "event_id" ] ] ] .
TM_student_club_income # PAS 社团成员->资金收入
    rr:predicateObjectMap [ rr:predicate <student_club/资金收取> ; rr:objectMap [ rr:parentTriplesMap TM_student_club_member ; rr:joinCondition [ rr:child "link_to_member" ; rr:parent "member_id" ] ] ] .
