    rr:predicateObjectMap [ rr:predicate <http://example.org/races/time> ; rr:objectMap [ rr:column "time" ; rr:datatype xsd:string ] ;
        rdfs:label "time"@en ;
        rdfs:comment "time of the location"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/races/url> ; rr:objectMap [ rr:column "url" ; rr:datatype xsd:string ] ;
        rdfs:label "url"@en ;
        rdfs:comment "introduction of races"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/races/refers_to_circuits> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/circuits> ; rr:joinCondition [ rr:child "circuitId" ; rr:parent "circuitId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/races/refers_to_seasons> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/seasons> ; rr:joinCondition [ rr:child "year" ; rr:parent "year" ] ] ] .

# === Table: formula_1.results (pk=resultId) ===
<http://example.org/tm/formula_1/results> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "results" ] ;
    rr:subjectMap [ rr:template "http://example.org/formula_1/{resultId}" ; rr:class ex:results ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/results/resultId> ; rr:objectMap [ rr:column "resultId" ; rr:datatype xsd:string ] ;
        rdfs:label "Result ID"@en ;
        rdfs:comment "the unique identification number identifying race result"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/raceId> ; rr:objectMap [ rr:column "raceId" ; rr:datatype xsd:string ] ;
        rdfs:label "race ID"@en ;
        rdfs:comment "the identification number identifying the race"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/driverId> ; rr:objectMap [ rr:column "driverId" ; rr:datatype xsd:string ] ;
        rdfs:label "driver ID"@en ;
        rdfs:comment "the identification number identifying the driver"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/constructorId> ; rr:objectMap [ rr:column "constructorId" ; rr:datatype xsd:string ] ;
        rdfs:label "constructor Id"@en ;
        rdfs:comment "the identification number identifying which constructors"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/number> ; rr:objectMap [ rr:column "number" ; rr:datatype xsd:string ] ;
        rdfs:label "number"@en ;
        rdfs:comment "number"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/grid> ; rr:objectMap [ rr:column "grid" ; rr:datatype xsd:string ] ;
        rdfs:label "grid"@en ;
        rdfs:comment "the number identifying the area where cars are set into a grid formation in order to start the race."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/position> ; rr:objectMap [ rr:column "position" ; rr:datatype xsd:string ] ;
        rdfs:label "position"@en ;
        rdfs:comment "The finishing position or track of circuits"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/positionText> ; rr:objectMap [ rr:column "positionText" ; rr:datatype xsd:string ] ;
        rdfs:label "position text"@en ;
        rdfs:comment "position text. not quite useful"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/positionOrder> ; rr:objectMap [ rr:column "positionOrder" ; rr:datatype xsd:string ] ;
        rdfs:label "position order"@en ;
        rdfs:comment "the finishing order of positions"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/points> ; rr:objectMap [ rr:column "points" ; rr:datatype xsd:string ] ;
        rdfs:label "points"@en ;
        rdfs:comment "points"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/laps> ; rr:objectMap [ rr:column "laps" ; rr:datatype xsd:string ] ;
        rdfs:label "laps"@en ;
        rdfs:comment "lap number"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/time> ; rr:objectMap [ rr:column "time" ; rr:datatype xsd:string ] ;
        rdfs:label "time"@en ;
        rdfs:comment "finish time. commonsense evidence: 1. if the value exists, it means the driver finished the race. 2. Only the time of the champion shows in the format of \"minutes: seconds.millionsecond\", the time of the other drivers shows as \"seconds.millionsecond\" , which means their actual time is the time of the champion adding the value in this cell."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/milliseconds> ; rr:objectMap [ rr:column "milliseconds" ; rr:datatype xsd:string ] ;
        rdfs:label "milliseconds"@en ;
        rdfs:comment "the actual finishing time of drivers in milliseconds. the actual finishing time of drivers"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/fastestLap> ; rr:objectMap [ rr:column "fastestLap" ; rr:datatype xsd:string ] ;
        rdfs:label "fastest lap"@en ;
        rdfs:comment "fastest lap number"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/rank> ; rr:objectMap [ rr:column "rank" ; rr:datatype xsd:string ] ;
        rdfs:label "rank"@en ;
        rdfs:comment "starting rank positioned by fastest lap speed"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/fastestLapTime> ; rr:objectMap [ rr:column "fastestLapTime" ; rr:datatype xsd:string ] ;
        rdfs:label "fastest Lap Time"@en ;
        rdfs:comment "fastest Lap Time. faster (smaller in the value) \"fastestLapTime\" leads to higher rank (smaller is higher rank)"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/fastestLapSpeed> ; rr:objectMap [ rr:column "fastestLapSpeed" ; rr:datatype xsd:string ] ;
        rdfs:label "fastest Lap Speed"@en ;
        rdfs:comment "fastest Lap Speed. (km / h)"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/statusId> ; rr:objectMap [ rr:column "statusId" ; rr:datatype xsd:string ] ;
        rdfs:label "status Id"@en ;
        rdfs:comment "status ID. its category description appear in the table status"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/refers_to_status> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/status> ; rr:joinCondition [ rr:child "statusId" ; rr:parent "statusId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/refers_to_constructors> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/constructors> ; rr:joinCondition [ rr:child "constructorId" ; rr:parent "constructorId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/refers_to_drivers> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/drivers> ; rr:joinCondition [ rr:child "driverId" ; rr:parent "driverId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/results/refers_to_races> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/races> ; rr:joinCondition [ rr:child "raceId" ; rr:parent "raceId" ] ] ] .

