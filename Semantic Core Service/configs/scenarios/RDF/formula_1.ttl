        rdfs:label "Circuit Id"@en ;
        rdfs:comment "circuit Id"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/races/name> ; rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ] ;
        rdfs:label "name"@en ;
