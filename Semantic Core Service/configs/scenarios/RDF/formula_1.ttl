# === Table: formula_1.qualifying (pk=qualifyId) ===
<http://example.org/tm/formula_1/qualifying> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "qualifying" ] ;
    rr:subjectMap [ rr:template "http://example.org/formula_1/{qualifyId}" ; rr:class ex:qualifying ] ;




    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/qualifyId> ; rr:objectMap [ rr:column "qualifyId" ; rr:datatype xsd:string ] ;
        rdfs:label "qualify Id"@en ;
        rdfs:comment "the unique identification number identifying qualifying. How does F1 Sprint qualifying work? Sprint qualifying is essentially a short-form Grand Prix  a race that is one-third the number of laps of the main event on Sunday. However, the drivers are battling for positions on the grid for the start of Sunday's race."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/raceId> ; rr:objectMap [ rr:column "raceId" ; rr:datatype xsd:string ] ;
        rdfs:label "race Id"@en ;
        rdfs:comment "the identification number identifying each race"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/driverId> ; rr:objectMap [ rr:column "driverId" ; rr:datatype xsd:string ] ;
        rdfs:label "driver Id"@en ;
        rdfs:comment "the identification number identifying each driver"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/constructorId> ; rr:objectMap [ rr:column "constructorId" ; rr:datatype xsd:string ] ;
        rdfs:label "constructor id"@en ;
        rdfs:comment "constructor Id"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/number> ; rr:objectMap [ rr:column "number" ; rr:datatype xsd:string ] ;
        rdfs:label "number"@en ;
        rdfs:comment "number"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/position> ; rr:objectMap [ rr:column "position" ; rr:datatype xsd:string ] ;
        rdfs:label "position"@en ;
        rdfs:comment "position or track of circuit"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/q1> ; rr:objectMap [ rr:column "q1" ; rr:datatype xsd:string ] ;
        rdfs:label "qualifying 1"@en ;
        rdfs:comment "time in qualifying 1. in minutes / seconds / ... commonsense evidence: Q1 lap times determine pole position and the order of the front 10 positions on the grid. The slowest driver in Q1 starts 10th, the next starts ninth and so on. All 20 F1 drivers participate in the first period, called Q1, with each trying to set the fastest time possible. Those in the top 15 move on to the next period of qualifying, called Q2. The five slowest drivers are eliminated and will start the race in the last five positions on the grid."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/q2> ; rr:objectMap [ rr:column "q2" ; rr:datatype xsd:string ] ;
        rdfs:label "qualifying 2"@en ;
        rdfs:comment "time in qualifying 2. in minutes / seconds / ... commonsense evidence: only top 15 in the q1 has the record of q2 Q2 is slightly shorter but follows the same format. Drivers try to put down their best times to move on to Q1 as one of the 10 fastest cars. The five outside of the top 10 are eliminated and start the race from 11th to 15th based on their best lap time."@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/q3> ; rr:objectMap [ rr:column "q3" ; rr:datatype xsd:string ] ;
        rdfs:label "qualifying 3"@en ;
        rdfs:comment "time in qualifying 3. in minutes / seconds / ... commonsense evidence: only top 10 in the q2 has the record of q3"@en ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/refers_to_constructors> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/constructors> ; rr:joinCondition [ rr:child "constructorId" ; rr:parent "constructorId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/refers_to_drivers> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/drivers> ; rr:joinCondition [ rr:child "driverId" ; rr:parent "driverId" ] ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/qualifying/refers_to_races> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/formula_1/races> ; rr:joinCondition [ rr:child "raceId" ; rr:parent "raceId" ] ] ] .

