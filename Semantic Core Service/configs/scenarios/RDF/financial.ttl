    rr:predicateObjectMap [ rr:predicate <http://example.org/account/refers_to_district> ; rr:objectMap [ rr:parentTriplesMap <http://example.org/tm/financial/district> ; rr:joinCondition [ rr:child "district_id" ; rr:parent "district_id" ] ] ] .

