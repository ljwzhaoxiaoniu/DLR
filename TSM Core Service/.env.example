# 复制为 .env 并填真值（.env 已 gitignore）
# Neo4j：本机 Desktop 实例，或任意 bolt 端点（Aura 用 neo4j+s://...）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# 可选：ONNX 模型目录（默认指向本地缓存；按机器改）
# TSM_MODEL_DIR=/path/to/bge-onnx

# 可选：数据集根（MINIDEV_sqlite 所在目录；默认仓库根）
# TSM_DATASET_DIR=/path/to/dataset-root

# 可选：MCP server 端口（默认 28795，start_backend.sh / tsm serve / 启动器共用）
# TSM_PORT=28795
